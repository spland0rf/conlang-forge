# What EAS uploads for a cloud build. When this file exists EAS uses it INSTEAD of .gitignore, which matters because
# .gitignore lists "app/" (mobile/app is generated by mobile/setup.sh, so it is never committed) and EAS would otherwise
# leave it out ("package.json does not exist in .../mobile/app").
__pycache__/
*.pyc
*.db
*.db-*
*.log
.env
.pytest_cache/
*.secret
node_modules/
.expo/
.git/
# the Python backend, its tests and docs are not part of the phone app
/conlang_forge/
/tests/
/docs/
/scripts/
/mobile/tests/
